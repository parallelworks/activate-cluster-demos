#!/bin/bash
# mylimits - show the QOS you can use, your GPU caps, and what you are using now.
#
# Reads Slurm's accounting database; it changes nothing. Safe to run any time.
# Install cluster-wide:  sudo install -m 0755 mylimits /software/bin/mylimits

set -u

USER_NAME="${SLURM_JOB_USER:-${USER:-$(id -un)}}"

command -v sacctmgr >/dev/null 2>&1 || {
  echo "mylimits: sacctmgr not found; run this on the cluster login node." >&2
  exit 1
}

# -P gives pipe-delimited output with no column truncation, so values like
# "cpu=176,gres/gpu=11,mem=1500G" arrive whole instead of ending in "+".
ASSOC=$(sacctmgr -n -P show assoc where user="$USER_NAME" \
          format=Account,QOS,DefaultQOS 2>/dev/null)

[ -n "$ASSOC" ] || {
  echo "mylimits: no Slurm association found for user '$USER_NAME'."
  echo "If you have just been added to the cluster, contact support@parallelworks.com."
  exit 1
}

# Which QOS can be preempted: any QOS named in another QOS's Preempt list.
PREEMPTED=$(sacctmgr -n -P show qos format=Preempt 2>/dev/null \
            | tr ',' '\n' | sed '/^$/d' | sort -u)

gpu_of() {  # extract gres/gpu=N from a TRES string
  echo "$1" | tr ',' '\n' | awk -F= '$1 == "gres/gpu" {print $2; exit}'
}

describe_qos() {
  local q="$1" row grptres maxpa prio grace mode cap peracct preempt
  row=$(sacctmgr -n -P show qos "$q" \
        format=Name,GrpTRES,MaxTRESPerAccount,Priority,GraceTime,PreemptMode 2>/dev/null | head -1)
  [ -n "$row" ] || return
  IFS='|' read -r _ grptres maxpa prio grace mode <<<"$row"

  cap=$(gpu_of "$grptres");     [ -n "$cap" ]     || cap="no cap"
  peracct=$(gpu_of "$maxpa");   [ -n "$peracct" ] || peracct="-"

  if echo "$PREEMPTED" | grep -qx "$q"; then
    preempt="yes"
    [ -n "${grace:-}" ] && [ "$grace" != "00:00:00" ] && preempt="yes (${grace} grace)"
  else
    preempt="no"
  fi

  printf '  %-14s %-10s %-12s %-9s %s\n' "$q" "$cap" "$peracct" "${prio:-0}" "$preempt"
}

echo
echo "  User          $USER_NAME"

FIRST=1
while IFS='|' read -r account qoslist defqos; do
  [ -n "$account" ] || continue
  if [ $FIRST -eq 1 ]; then FIRST=0; else echo; fi
  echo "  Account       $account"
  echo "  Default QOS   ${defqos:-normal}   (applied automatically when you do not pass --qos)"
  echo
  printf '  %-14s %-10s %-12s %-9s %s\n' "QOS" "GPU cap" "Per-group" "Priority" "Preemptible"
  printf '  %s\n' "---------------------------------------------------------------------------"
  echo "$qoslist" | tr ',' '\n' | sed '/^$/d' | while read -r q; do describe_qos "$q"; done
done <<<"$ASSOC"

# ---- what you are using right now -------------------------------------------
RUN_GPUS=$(squeue --me -h -t RUNNING -O "tres-alloc:200" 2>/dev/null \
           | grep -oE 'gres/gpu=[0-9]+' | cut -d= -f2 | awk '{s+=$1} END {print s+0}')
RUN_JOBS=$(squeue --me -h -t RUNNING 2>/dev/null | wc -l)
PEND_JOBS=$(squeue --me -h -t PENDING 2>/dev/null | wc -l)
AT_CAP=$(squeue --me -h -t PENDING -o "%r" 2>/dev/null | grep -c "QOSGrpGRES")

echo
echo "  Right now"
echo "  ---------------------------------------------------------------------------"
printf '  Running       %s job(s), %s GPU(s)\n' "${RUN_JOBS:-0}" "${RUN_GPUS:-0}"
if [ "${AT_CAP:-0}" -gt 0 ]; then
  printf '  Pending       %s job(s), of which %s waiting at your GPU cap (QOSGrpGRES)\n' \
    "${PEND_JOBS:-0}" "$AT_CAP"
else
  printf '  Pending       %s job(s)\n' "${PEND_JOBS:-0}"
fi

cat <<'EOF'

  The GPU cap is the most your group can run at once. It never limits how many
  jobs you may queue. Add --qos=general to borrow from the shared pool, or
  --qos=spot for uncapped preemptible capacity (checkpoint your work).
  Details: squeue --me   |   sacct -X --format=JobID,QOS,Elapsed,State

EOF
